     ]
    }
   ],
   "source": [
    "# Define transformation (if needed)\n",
    "transform = transforms.Compose([\n",
    "    transforms.ToTensor(),  # Convert to tensor\n",
    "])\n",
    "# Load dataset \n",
    "root_dir = \"../data/General_Flood_v3\"\n",
    "dataset = FloodDataset(root_dir=root_dir, split=\"train\", transform=transform)\n",
    "\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "\n",
    "model_name = \"pidnet\"\n",
    "\n",
    "model = get_pidnet(model_name=model_name)\n",
    "if callable(model):\n",
    "    model = model()  # Instantiate if it's a class/function\n",
    "\n",
    "model.augment = False\n",
    "output_dir = \"../output/crp/pidnet_flood\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "afb44d04",
   "metadata": {},
